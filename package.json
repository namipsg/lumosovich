{
  "name": "lumosovich",
  "version": "0.5.1",
  "description": "A small, typed Node.js client for the TMDB API",
  "keywords": [
    "tmdb",
    "themoviedb",
    "movie",
    "tv",
    "api-client",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namipsg/lumosovich.git"
  },
  "homepage": "https://github.com/namipsg/lumosovich#readme",
  "bugs": {
    "url": "https://github.com/namipsg/lumosovich/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/index.cjs",
    "test": "npm run build && node scripts/check-coverage.mjs && node scripts/generate-fixtures.mjs --check && npm run test:types && node --test test/*.test.mjs",
    "test:types": "tsc --project tsconfig.types.json",
    "check:coverage": "npm run build && node scripts/check-coverage.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "test:live": "npm run build && node test/live-smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
